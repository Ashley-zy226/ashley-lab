---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import EntryRow from '../../components/EntryRow.astro';
import { entries } from '../../lib/content';
const notes = await entries('notes');
const courses = [...new Set(notes.map(({ data }) => data.course))];
const description = '按课程和主题组织的学习笔记，整理概念、例题和实践过程。';
---
<Base title="学习笔记" description={description}>
  <PageIntro label="02 / KNOWLEDGE BASE" title="学习笔记" description={description} />
  <div class="detail-stack narrow">
    {courses.length ? courses.map((course) => <section class="panel course"><div class="panel-top"><h2>{course}</h2><span>{notes.filter(({ data }) => data.course === course).length} 篇</span></div>{notes.filter(({ data }) => data.course === course).map((entry) => <EntryRow entry={entry} level={3} />)}</section>) : <p class="empty">课程笔记整理中。</p>}
  </div>
</Base>
