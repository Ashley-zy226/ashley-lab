---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../lib/site';
---
<Base title="项目作品" description="个人项目、实现过程与开源仓库。">
  <PageIntro label="03 / PROJECTS" title="项目作品" description="记录做过的项目、解决的问题，以及可以复现的实现。" />
  <div class="detail-stack narrow">
    {projects.length ? projects.map((project) => <section class="panel project" id={project.id}>
      <div class="panel-top"><span class="feature-icon"><Icon name="box" /></span><span class="pill">{project.status}</span></div>
      <h2>{project.title}</h2><p>{project.detail}</p>
      <div class="pills">{project.stack.map((item) => <span class="pill">{item}</span>)}</div>
      <div class="project-links">
        {project.repository ? <a class="text-link" href={project.repository}><Icon name="github" size={16} /> GitHub 仓库 <Icon name="up" size={14} /></a> : <span class="muted"><Icon name="github" size={16} /> GitHub 仓库链接待补充</span>}
        {project.demo && <a class="text-link" href={project.demo}>浏览站点 <Icon name="up" size={14} /></a>}
      </div>
    </section>) : <p class="empty">项目资料整理中。</p>}
  </div>
</Base>
