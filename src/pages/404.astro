---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="页面未找到" noindex>
  <section class="not-found">
    <p class="eyebrow"><span></span> HTTP / 404</p>
    <h1>页面未找到</h1>
    <p>这个地址可能已变更，也可能暂时没有内容。</p>
    <div class="hero-actions"><a class="button primary" href="/">返回首页 <Icon name="arrow" size={17} /></a><a class="button secondary" href="/search/">搜索文章</a></div>
  </section>
</Base>
