---
import { render } from 'astro:content';
import Base from './Base.astro';
import { categories, topics } from '../lib/site';
import { dateText, type Entry } from '../lib/content';
import 'katex/dist/katex.min.css';
const { entry } = Astro.props as { entry: Entry };
const { data } = entry;
const { Content, headings } = await render(entry);
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
---
<Base title={data.title} description={data.description} article>
  <div class="article-top">
    <nav class="breadcrumb" aria-label="面包屑"><a href="/">首页</a><span>/</span><a href="/blog/">技术博客</a><span>/</span><span>{categories[data.category]}</span></nav>
    <header class="article-heading">
      <div class="entry-meta"><time datetime={dateText(data.date)}>{dateText(data.date)}</time>{data.updated && <span>更新于 <time datetime={dateText(data.updated)}>{dateText(data.updated)}</time></span>}{data.example && <span class="example-tag">示例内容</span>}</div>
      <h1>{data.title}</h1>
      <p>{data.description}</p>
      <div class="pills">{data.tags.map((key) => <a class="pill" href={`/blog/tag/${key}/`}>{topics[key]}</a>)}</div>
    </header>
  </div>
  <div class:list={['article-grid', { 'without-toc': !toc.length }]}>
    {toc.length > 0 && <aside class="toc">
      <nav aria-label="文章目录"><h2>文章目录</h2><ol>{toc.map(({ depth, slug, text }) => <li class:list={[{ sub: depth === 3 }]}><a href={`#${encodeURIComponent(slug)}`}>{text}</a></li>)}</ol></nav>
    </aside>}
    <article class="prose" data-pagefind-body>
      <span hidden data-pagefind-meta="title">{data.title}</span>
      <Content />
    </article>
  </div>
  <div class="article-end"><a href="/blog/">← 返回技术博客</a></div>
</Base>

<script>
  const toc = document.querySelector<HTMLElement>('.toc');
  if (toc) {
    const sections = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')).flatMap((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      return heading ? [{ heading, link }] : [];
    });

    let current: HTMLAnchorElement | undefined;
    let frame: number | undefined;

    function updateCurrent() {
      frame = undefined;
      const threshold = Math.min(112, window.innerHeight * 0.2);
      const atEnd = window.scrollY > 0 &&
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      const section = atEnd
        ? sections.at(-1)
        : sections.findLast(({ heading }) => heading.getBoundingClientRect().top <= threshold);
      const next = section?.link;
      if (next === current) return;

      current?.removeAttribute('aria-current');
      current = next;
      if (!current) return;

      current.setAttribute('aria-current', 'location');
      if (toc && toc.scrollHeight > toc.clientHeight) {
        const item = current.getBoundingClientRect();
        const bounds = toc.getBoundingClientRect();
        if (item.top < bounds.top) toc.scrollTop += item.top - bounds.top;
        else if (item.bottom > bounds.bottom) toc.scrollTop += item.bottom - bounds.bottom;
      }
    }

    function scheduleUpdate() {
      frame ??= requestAnimationFrame(updateCurrent);
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', scheduleUpdate);
    window.addEventListener('load', scheduleUpdate, { once: true });
    scheduleUpdate();
  }
</script>
